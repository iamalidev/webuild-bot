# ═══════════════════════════════════════════════════════════════
#  WeBuild Bot — konfiguratsiya
#  Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
#  ⚠️ `.env` ni HECH QACHON git ga qo'shmang.
# ═══════════════════════════════════════════════════════════════

# ─── Bot ────────────────────────────────────────────────────────
# BotFather → /newbot → token oling
BOT_TOKEN=your_bot_token_here

# ─── 👑 Bot egasi (Admin) ──────────────────────────────────────
# Faqat shu ID lar admin buyruqlarini ishlata oladi.
# Vergul bilan ajratiladi. O'z ID ingizni bilmasangiz: @userinfobot ga /start yozing.
OWNER_IDS=6190984042

# ─── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:1234@127.0.0.1:5432/webuild_bot
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=5

# ─── Kurs ma'lumotlari ─────────────────────────────────────────
COURSE_TITLE=WeBuild — AI bilan Web Sayt Yasash Kursi
COURSE_DESCRIPTION=Bu kursda siz AI yordamida professional web saytlar yasashni o'rganasiz. Real loyihalar, amaliy darslar, va zamonaviy texnologiyalar.
COURSE_PRICE=500,000 so'm
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=XXXXXXXX

# Yopiq kanal ID si (bot shu kanalda ADMIN bo'lishi shart!)
# Kanal ID ni bilish uchun: botni kanalga admin qiling, keyin kanalga xabar yozing
# va @userinfobot ga forward qiling — yoki botni ishga tushiring, logda ko'rinadi.
# Masalan: -1001234567890
COURSE_CHANNEL_ID=-1001234567890

# Invite link muddati (soat). 24 = 1 kun, 48 = 2 kun
INVITE_EXPIRE_HOURS=24

# ─── Kurs rasmi (ixtiyoriy) ────────────────────────────────────
# Telegram file_id yoki URL. Bo'sh qoldirilsa rasmsiz chiqadi.
COURSE_PHOTO=

# ─── Xizmat ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
